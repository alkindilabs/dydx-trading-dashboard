{
  "name": "dydx-analytics-dashboard",
  "version": "3.1.0",
  "description": "Trading analytics dashboard for dYdX v4",
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "dev": "python3 -m http.server 8000",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "cf:dev": "CLOUDFLARE_API_TOKEN=\"$CLOUDFLARE_ALKINDI_API_TOKEN\" wrangler dev",
    "cf:deploy": "CLOUDFLARE_API_TOKEN=\"$CLOUDFLARE_ALKINDI_API_TOKEN\" wrangler deploy",
    "cf:tail": "CLOUDFLARE_API_TOKEN=\"$CLOUDFLARE_ALKINDI_API_TOKEN\" wrangler tail",
    "cf:whoami": "CLOUDFLARE_API_TOKEN=\"$CLOUDFLARE_ALKINDI_API_TOKEN\" wrangler whoami"
  },
  "keywords": [
    "dydx",
    "trading",
    "analytics",
    "dashboard",
    "defi",
    "crypto"
  ],
  "author": "Alkindi Labs (independent — not affiliated with dYdX Trading Inc.)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alkindilabs/dydx-trading-dashboard"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "wrangler": "^3.91.0"
  }
}
