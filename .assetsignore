# Files in the asset directory that must NOT be uploaded to the public bucket.
# Matches gitignore-style globs.
.git/
.github/
.claude/
.playwright-mcp/
.wrangler/
node_modules/
test/
docs/
package.json
package-lock.json
.npmrc
CLAUDE.md
README.md
wrangler.jsonc
.assetsignore
.gitignore
.dev.vars
.dev.vars.*
*.log
*.tmp
*.png
*.jpg
*.jpeg
*.webp
.DS_Store

# Playwright local + CI artifacts
playwright.config.mjs
playwright-report/
test-results/
playwright/

# No markdown is ever served. Catches CLAUDE.md, README.md, and any future
# audit / spec / scratch .md a contributor drops into the repo root.
*.md

# Toolchain configs have no value at the edge. Glob catches drift.
tsconfig*.json
.eslintrc*
.prettierrc*
